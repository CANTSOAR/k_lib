@inbook{Revuz_Yor_1999, address={Berlin, Heidelberg}, title={Girsanov’s Theorem and First Applications}, ISBN={9783662064009}, url={https://doi.org/10.1007/978-3-662-06400-9_9}, DOI={10.1007/978-3-662-06400-9_9}, abstractNote={In this chapter we study the effect on the space of continuous semimartingales of an absolutely continuous change of probability measure. The results we describe have far-reaching consequences from the theoretical point of view as is hinted at in Sect. 2; they also permit many explicit computations as is seen in Sect. 3.}, booktitle={Continuous Martingales and Brownian Motion}, publisher={Springer}, author={Revuz, Daniel and Yor, Marc}, editor={Revuz, Daniel and Yor, Marc}, year={1999}, pages={325–364}, language={en} }